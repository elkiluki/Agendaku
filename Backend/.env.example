PORT=3000

# Database (default XAMPP: user root, password kosong)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agendaku

# Ganti dengan string acak yang panjang
JWT_SECRET=ganti_dengan_string_acak_yang_panjang
JWT_EXPIRES_IN=30d

# Offset zona waktu default (menit) untuk filter tanggal/kalender. WIB = 420
DEFAULT_TZ_OFFSET_MIN=420
